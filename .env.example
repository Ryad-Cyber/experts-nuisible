# Clé API Resend (https://resend.com/api-keys) — obligatoire pour l'envoi d'emails du formulaire de contact
RESEND_API_KEY=

# Adresse qui reçoit les demandes de devis (optionnel, défaut : siteConfig.email)
CONTACT_TO_EMAIL=

# Adresse d'expédition (optionnel, défaut : onboarding@resend.dev)
# À remplacer par une adresse sur un domaine vérifié dans Resend une fois le domaine configuré.
CONTACT_FROM_EMAIL=
